<?xml version="1.0" encoding="utf-8"?>
<!--
   The account's token and this install's device ID must not come back on another phone: a
   restored copy would act as this device on the server. The cache comes back from the server.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/server_auth.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/server_auth.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
